---
import BaseLayout from "@layouts/BaseLayout.astro";
import ShowCaseList from "@src/components/home/ShowCaseList.astro";
---

<BaseLayout>
  <header class="mb-2 pb-5 text-justify">
    Hi, I'm Leo, a software engineer interested in low-level systems.
  </header>
  <ShowCaseList
    contentName="work"
    content="work"
    showDay={false}
    linkText="overview"
  />
  <ShowCaseList
    contentName="projects"
    content="projects"
    showDay={false}
    linkText="overview"
  />
  <ShowCaseList contentName="notes" content="notes" linkText="see all" />
</BaseLayout>
